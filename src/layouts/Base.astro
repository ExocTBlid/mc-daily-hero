---
import '../styles/site.css'
import { sitePath } from '../lib/site'
import { version } from '../../package.json'

interface Props {
  title: string
  description?: string
}
const { title, description = 'One Marvel Champions hero deck each day.' } = Astro.props
const home = sitePath()

// The sentence at the top of every page. Clear it to remove the notice.
// A visitor who hides it sees it again when this sentence changes.
const siteNotice =
  'This site is experimental. The decks are generated and are simply here for fun and possibly inspiration.'
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={sitePath('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#111111" />
    {siteNotice && (
      <script is:inline define:vars={{ siteNotice }}>
        try {
          if (localStorage.getItem('daily-hero-notice') === siteNotice) {
            document.documentElement.dataset.notice = 'hidden'
          }
        } catch {}
      </script>
    )}
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="mark" href={home}>Daily Hero</a>
        <nav>
          <a href={home}>Today</a>
          <a href={sitePath('archive')}>Archive</a>
        </nav>
      </div>
    </header>
    <div class="wrap page">
      {siteNotice && (
        <aside class="site-notice" data-text={siteNotice}>
          <p>{siteNotice}</p>
          <button type="button">Hide</button>
        </aside>
      )}
      <slot />
      <footer class="credit">
        <p>
          Marvel Champions is published by Fantasy Flight Games. Card names link to
          <a href="https://marvelcdb.com/" target="_blank" rel="noopener noreferrer">MarvelCDB</a>. Card data comes from
          <a href="https://github.com/zzorba/marvelsdb-json-data">marvelsdb-json-data</a>.
          Rules reference: <a href="https://marvelcdb.com/rules" target="_blank" rel="noopener noreferrer">MarvelCDB</a>.
        </p>
        <p class="version">v{version}</p>
      </footer>
    </div>
    {siteNotice && (
      <script is:inline>
        const notice = document.querySelector('.site-notice')
        notice?.querySelector('button')?.addEventListener('click', () => {
          notice.setAttribute('hidden', '')
          try {
            localStorage.setItem('daily-hero-notice', notice.dataset.text ?? '')
          } catch {}
        })
      </script>
    )}
  </body>
</html>
